rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;

      match /saved_venues/{placeId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /navigated_venues/{placeId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /friendships/{docId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );

      allow delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    match /venue_reviews/{reviewId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
      );

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /venuePhotoCache/{placeId} {
      allow read, write: if isSignedIn();
    }

    match /venueSearchCache/{key} {
      allow read, write: if isSignedIn();
    }

    // Bakım durumu — herkes okuyabilir (auth gerekmez), kimse yazamaz.
    // NetworkService'in katman 3 kontrolü için kullanılır.
    // Firestore Console'dan: appConfig/maintenance { active: true/false } belgesi oluştur.
    match /appConfig/maintenance {
      allow read: if true;
      allow write: if false;
    }

    // API kullanım sayaçları — authenticated kullanıcılar yazar.
    // Doküman henüz yoksa (resource == null) serbest yaz;
    // varsa limit alanlarına dokunma.
    match /appConfig/apiUsage {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null ||
        !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['photo_limit', 'search_new_limit', 'search_legacy_limit'])
      );
    }

    // Diğer appConfig dokümanları (placesApi vb.) — sadece okunabilir.
    match /appConfig/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // FCM token deposu — sadece token sahibi okuyup yazabilir.
    // Cloud Function Admin SDK ile eriştiği için istemci tarafı okuma kuralı gerekmez.
    // users/{uid} dökümanındaki fcmToken alanı kaldırıldı; artık burada tutulur.
    match /fcmTokens/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Push bildirim kuyruğu — Cloud Function bu dökümanları okuyup FCM gönderir.
    // Herhangi bir giriş yapmış kullanıcı başkasına bildirim yazabilir;
    // okuma sadece kendi bildirimlerine izinli (Cloud Function admin olarak okur).
    match /notifications/{uid}/{document=**} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == uid;
    }

    // Buluşma geçmişi — katılımcı UID'lerinden biri oturum açmış kullanıcıysa erişim var.
    match /meetingHistory/{recordId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids;

      allow update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;
    }

    // Engelleme kayıtları — App Store Guideline 1.2 gereği.
    // Kullanıcı yalnızca kendi engellemelerini oluşturur/okur/siler.
    match /blocks/{blockId} {
      allow read: if isSignedIn() &&
        resource.data.blockerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        request.resource.data.blockerUid == request.auth.uid;

      allow delete: if isSignedIn() &&
        resource.data.blockerUid == request.auth.uid;
    }

    // Şikâyet kayıtları — App Store Guideline 1.2 gereği.
    // Kullanıcı şikâyet oluşturabilir; okuma/güncelleme sadece moderasyon
    // tarafında (Admin SDK) yapılır.
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
